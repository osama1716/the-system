rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // True only for the one account a Cloud Function has stamped with a
    // custom auth claim (see functions/index.js setAdmin) — never something
    // a client can claim about itself. This is what "admin" actually means
    // everywhere in these rules.
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Schema guard: the app only ever writes {state, updatedAt} at the top
    // level (see js/cloud.js push()), and `state` only ever has these 9 keys
    // (see js/constants.js defaultState()). This stops a compromised or
    // buggy client from writing arbitrary junk into your own document, spoofing
    // the sync timestamp, or growing the doc without bound — it's authorization
    // (isOwner) PLUS shape/size validation, not authorization alone.
    function isValidSave(data) {
      return data.keys().hasOnly(['state', 'updatedAt'])
        && data.updatedAt == request.time
        && data.state is map
        && data.state.keys().hasOnly([
             'schema', 'settings', 'player', 'intTypes',
             'intelligences', 'tasks', 'log', 'levelHistory', 'dailyStats'
           ])
        && data.state.get('tasks', []).size() < 3000
        && data.state.get('log', []).size() < 500
        && data.state.get('levelHistory', []).size() < 5000
        && data.state.get('intTypes', []).size() < 100;
    }

    match /users/{userId} {
      // Admin read is intentionally direct (no Cloud Function mediating it) —
      // this gives the admin's own browser unaudited read access to a user's
      // entire private state (settings, full task/notes text, everything).
      // There is no server-side log of which profiles the admin looked at,
      // since only writes go through Cloud Functions. Accepted trade-off,
      // not an oversight — see the plan doc for the explicit sign-off.
      allow read: if isOwner(userId) || isAdmin();
      // Writes stay owner-only, unchanged. The admin never writes here
      // directly, even to grant EXP — see pendingGrants below for why.
      allow create, update: if isOwner(userId) && isValidSave(request.resource.data);
      allow delete: if false;

      // Cloud-Function-authorized EXP grants (mission approvals, manual
      // adjustments) land here instead of being written into this user's
      // player.exp/level directly, to avoid racing the client's own
      // debounced push() of the whole parent document (see plan doc "Why
      // pendingGrants"). Only the Admin SDK (which bypasses these rules
      // entirely) can create one; the client can only read its own and
      // delete it once applied locally.
      match /pendingGrants/{grantId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if false;
      }

      // Admin-authored messages/bonuses/penalties (see applyAdjustment in
      // functions/index.js). The owner can only toggle their own `read` flag
      // — a normal, low-risk same-user write, no different in kind from any
      // other field the client already writes to its own state — never any
      // other field, and never create (admin content only, via Admin SDK).
      // Append-only record of every EXP movement, and the only thing the
      // public standing is computed from. The point is not that the client
      // cannot write here — it must, since it is the only party that knows a
      // quest was finished — but that what it writes cannot afterwards be
      // revised. An inflated standing therefore has to be built out of
      // individual, server-timestamped entries that stay on the record, rather
      // than by editing one number in local storage and pushing it.
      //
      // `at == request.time` pins the timestamp to the server's clock, so the
      // ordering can't be dressed up by a device with its date moved.
      match /expEvents/{eventId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId)
          && request.resource.data.keys().hasOnly(['delta', 'source', 'at', 'priceId'])
          && request.resource.data.delta is number
          && request.resource.data.delta >= -100000
          && request.resource.data.delta <= 100000
          && request.resource.data.at == request.time
          && (!('source' in request.resource.data)
              || (request.resource.data.source is string && request.resource.data.source.size() <= 80));
        // Never. A record that can be rewritten is not a record.
        allow update, delete: if false;
      }

      match /inbox/{msgId} {
        allow read: if isOwner(userId);
        allow update: if isOwner(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
        allow create, delete: if false;
      }
    }

    // Admin-only directory of {uid -> email}, populated by an Auth onCreate
    // trigger (functions/index.js), so the admin panel can look up a specific
    // user by email without an Admin SDK call per lookup. Never public —
    // unlike the leaderboard below, this contains real emails.
    match /userDirectory/{userId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Claimed display names, keyed by the normalised name so the database
    // itself enforces uniqueness — a second writer for the same name simply
    // fails. Writes go only through claimUsername (Admin SDK), never the
    // client: two clients could otherwise both check "free?" and both write.
    // Readable so the rename field can preview availability; the mapping is
    // name -> uid, which the public leaderboard will expose anyway.
    match /usernames/{nameKey} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // The public projection of users/{uid} — the handful of fields the ranking
    // page shows, and nothing else. Written only by the mirrorLeaderboard
    // trigger in functions/index.js: a client that could write its own row
    // could write anybody's, and here the row IS the score.
    //
    // Signed-in read rather than world-readable. Anyone can make a free
    // account, so this is friction against casual scraping rather than real
    // protection — but it costs nothing (you must be signed in to be ranked
    // at all) and it keeps the board consistent with usernames above.
    match /leaderboard/{userId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Running totals behind the public standing: the grandfathered baseline
    // and the sum of every journalled event. Server-only in both directions —
    // this is the arithmetic the leaderboard is trusted for, so a client that
    // could write it would make the whole journal pointless.
    // What the evaluator charged for each task it priced. Server-only: the
    // client is given the id so it can point at one, never the ability to
    // invent the price it points at.
    match /aiPrices/{userId}/prices/{priceId} {
      allow read, write: if false;
    }

    match /expTotals/{userId} {
      // Readable by its owner, because the app now corrects its own EXP back
      // to this figure — the journal is the authority for the number on your
      // own screen, not only for the one on the board. Still never writable:
      // being able to read what you are worth is not the same as being able
      // to set it.
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false;
    }

    // Per-user daily counter for AI task evaluations (each one costs money).
    // Server-only in both directions — a client that could read this could
    // probe the quota, and one that could write it could reset its own.
    match /aiUsage/{userId} {
      allow read, write: if false;
    }

    // A user disputes the value the AI evaluator gave one of their tasks.
    // This is the human review path over an automatic system: the evaluator
    // decides, and a person can be asked to look again. Status is forced to
    // 'pending' on create and no outcome fields may be pre-seeded; only
    // resolveAppeal/rejectAppeal in functions/index.js can transition it,
    // which is why update is flatly false for every client, admin included.
    match /appeals/{appealId} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && !('newPt' in request.resource.data);
      // Rules can't filter a list query, only allow/reject it whole — a
      // regular user's own "my appeals" query must add
      // .where('userId','==', myUid) or Firestore rejects it outright, even
      // though every matching doc would've been theirs anyway. Only the
      // admin's "all pending" queue query can omit that filter.
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow update, delete: if false;
    }
  }
}
