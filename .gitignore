# Cloud Functions / tooling — installed locally, never committed
node_modules/
functions/node_modules/
scripts/node_modules/

# Firebase CLI local state
.firebase/
firebase-debug.log
firebase-debug.*.log

# Service account keys must never be committed — keep them outside this repo
# entirely (see scripts/bootstrap-admin.js). These patterns are a safety net,
# not the actual safeguard.
*serviceAccount*.json
*service-account*.json
*-firebase-adminsdk-*.json

# Eval harness: the API key and its results stay out of the repo.
evals/.apikey
evals/results/

# Lockfiles for the little helper scripts are committed (see scripts/), but
# agent and editor scaffolding is not: .claude/launch.json is a local preview
# server config, useful on this machine and meaningless in the history.
.claude/

# The design handoff that came with the original mockups. Kept on disk because
# it is worth having, out of the repo because it is not part of the app — and
# because a second copy of anything inside the project folder is how you end
# up editing the wrong one.
The System Growth Tracker/
The System Growth Tracker.zip
